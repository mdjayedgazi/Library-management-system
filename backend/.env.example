# Copy this file to .env and fill in the values from your own Supabase project.
#
# Get the complete connection string from:
# Supabase Dashboard -> your project -> Connect -> Session pooler
#
# Do not construct the pooler hostname from the region. The aws-<index> part
# must be copied from the dashboard.
#
# Keep the postgresql+psycopg:// prefix so SQLAlchemy uses the async Psycopg 3
# driver. Shared-pooler usernames use postgres.<PROJECT-REF>.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@<POOLER-HOST>:5432/postgres

# Generate a long random value for local development. Never commit the real .env.
SECRET_KEY=<GENERATE-A-LONG-RANDOM-SECRET>

# Optional overrides (defaults are shown in app/core/config.py).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# ALGORITHM=HS256

# Seed script credentials (required by app/seed.py).
# These passwords are used for development seed accounts only.
# Librarian accounts (librarian, assistant) use SEED_LIBRARIAN_PASSWORD.
# Member accounts (alice, bob, carol, etc.) use SEED_MEMBER_PASSWORD.
# There are no defaults: the seed script will fail if these are not set.
SEED_LIBRARIAN_PASSWORD=<STRONG-PASSWORD-FOR-LIBRARIAN-ACCOUNTS>
SEED_MEMBER_PASSWORD=<STRONG-PASSWORD-FOR-MEMBER-ACCOUNTS>
